{
    "name": "bidirekt/php-sdk",
    "description": "Generate a service's Bidirekt contract from PHP attributes or docblock tags",
    "license": "MIT",
    "require": {
        "php": "^8.0",
        "composer-runtime-api": "^2.2",
        "nikic/php-parser": "^5.6.2",
        "phpstan/phpdoc-parser": "^2"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "Bidirekt\\PhpSdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bidirekt\\PhpSdk\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/php-sdk"
    ],
    "config": {
        "platform": {
            "php": "8.0.30"
        }
    },
    "scripts": {
        "check": "php-cs-fixer fix --dry-run --diff",
        "format": "php-cs-fixer fix",
        "lint": "phpstan analyse",
        "test": "phpunit"
    }
}
