{
    "name": "acme/petstore-api",
    "description": "The pet store API, on Slim 4",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.0",
        "slim/psr7": "^1.7",
        "slim/slim": "^4.14"
    },
    "require-dev": {
        "bidirekt/php-sdk": "dev-main"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../..",
            "options": {
                "symlink": false,
                "reference": "none",
                "versions": {
                    "bidirekt/php-sdk": "dev-main"
                }
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
